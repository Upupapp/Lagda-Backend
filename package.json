{
  "name": "@lagda/backend",
  "private": true,
  "version": "0.0.0",
  "description": "LAGDA eSignature backend \u2014 modular monolith. Foundation stage.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --build --force && tsc -p tsconfig.tools.json",
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:openapi": "npm run openapi:emit && git diff --exit-code -- openapi.json",
  "verify": "npm run typecheck && npm run verify:openapi && npm run lint && npm test && npm run build",
  "check": "npm run typecheck && npm run lint && npm test",
    "ci": "npm run typecheck && npm run lint && npm test && npm run build",
    "openapi:emit": "node --experimental-strip-types infra/emit-openapi.ts openapi.json",
    "db:migrate": "node --experimental-strip-types infra/migrate.ts up",
    "db:migrate:status": "node --experimental-strip-types infra/migrate.ts status",
    "signing:reconcile": "node --experimental-strip-types infra/reconcile-signing-workflow.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check:full": "npm run check && npm run test:integration",
    "test:tenancy": "vitest run --config vitest.integration.config.ts packages/db/src/tenancy.integration.test.ts",
    "dev:api": "tsx watch packages/api/src/server/main.ts",
    "start:api": "node packages/api/dist/server/main.js",
    "dev:worker": "tsx watch packages/worker/src/server/main.ts",
    "start:worker": "node packages/worker/dist/server/main.js",
    "preflight": "node infra/preflight.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "tsx": "^4.23.11",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.2",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true
  }
}
