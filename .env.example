# LAGDA backend — example configuration.
#
# Foundation stage: no runtime configuration is required yet, because no process
# reads configuration. Nothing here is a secret and nothing here is real.
#
# Later commands add their own variables as the packages that consume them are
# built. Configuration will be parsed and VALIDATED ONCE at process startup and
# injected, rather than read from `process.env` throughout business code.
#
# Do not add production credentials, signing secrets, storage keys, email API
# keys, or cookie secrets to this file at any point.

NODE_ENV=development

# ── Database ────────────────────────────────────────────────────────────────
# Local PostgreSQL. These are FAKE placeholder values, not credentials.
# Create the databases once: CREATE DATABASE lagda_dev; CREATE DATABASE lagda_test;
DATABASE_URL=postgresql://user:password@localhost:5432/lagda_dev

# Integration tests only. The database name MUST contain "test" — the harness
# truncates tables and refuses to run against anything else.
DATABASE_TEST_URL=postgresql://user:password@localhost:5432/lagda_test

# Optional. Defaults: min 0, max 10, connect 10s, idle 30s, ssl off.
# DATABASE_POOL_MAX=10
# DATABASE_SSL=true

# ── API process (BACKEND-11) ────────────────────────────────────────────────
# Loopback by default. Production behind a reverse proxy typically needs 0.0.0.0.
API_HOST=127.0.0.1
API_PORT=8080

# Exact origins, comma separated. NEVER "*" — sessions are cookie-based, so a
# wildcard is either ignored by the browser or unsafe. Empty disables CORS
# entirely, which is correct when the frontend is same-origin.
CORS_ORIGINS=http://localhost:5173

# How much of the X-Forwarded-For chain to believe.
#   unset / false  → trust nothing (the default, and correct for local dev)
#   1              → exactly one reverse proxy in front
#   10.0.0.1,...   → specific trusted proxy addresses
# TRUST_PROXY=true is REJECTED: it trusts the whole chain, which would let any
# client choose the IP recorded as signing evidence.
# See docs/backend/api/TRUST_PROXY.md.
TRUST_PROXY=

LOG_LEVEL=info
# JSON bodies only. Uploads get their own limit on their own routes (BACKEND-18).
REQUEST_BODY_LIMIT=1048576
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=15000
