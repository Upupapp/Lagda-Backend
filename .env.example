# LAGDA backend — example configuration.
#
# Foundation stage: no runtime configuration is required yet, because no process
# reads configuration. Nothing here is a secret and nothing here is real.
#
# Later commands add their own variables as the packages that consume them are
# built. Configuration will be parsed and VALIDATED ONCE at process startup and
# injected, rather than read from `process.env` throughout business code.
#
# Do not add production credentials, signing secrets, storage keys, email API
# keys, or cookie secrets to this file at any point.

NODE_ENV=development

# ── Database ────────────────────────────────────────────────────────────────
# Local PostgreSQL. These are FAKE placeholder values, not credentials.
# Create the databases once: CREATE DATABASE lagda_dev; CREATE DATABASE lagda_test;
DATABASE_URL=postgresql://user:password@localhost:5432/lagda_dev

# Integration tests only. The database name MUST contain "test" — the harness
# truncates tables and refuses to run against anything else.
DATABASE_TEST_URL=postgresql://user:password@localhost:5432/lagda_test

# Optional. Defaults: min 0, max 10, connect 10s, idle 30s, ssl off.
# DATABASE_POOL_MAX=10
# DATABASE_SSL=true

# ── API process (BACKEND-11) ────────────────────────────────────────────────
# Loopback by default. Production behind a reverse proxy typically needs 0.0.0.0.
API_HOST=127.0.0.1
API_PORT=8080

# Exact origins, comma separated. NEVER "*" — sessions are cookie-based, so a
# wildcard is either ignored by the browser or unsafe. Empty disables CORS
# entirely, which is correct when the frontend is same-origin.
CORS_ORIGINS=http://localhost:5173

# How much of the X-Forwarded-For chain to believe.
#   unset / false  → trust nothing (the default, and correct for local dev)
#   1              → exactly one reverse proxy in front
#   10.0.0.1,...   → specific trusted proxy addresses
# TRUST_PROXY=true is REJECTED: it trusts the whole chain, which would let any
# client choose the IP recorded as signing evidence.
# See docs/backend/api/TRUST_PROXY.md.
TRUST_PROXY=

LOG_LEVEL=info
# JSON bodies only. Uploads get their own limit on their own routes (BACKEND-18).
REQUEST_BODY_LIMIT=1048576
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=15000

# ── Worker (separate process: `npm run start:worker`) ────────────────────────
#
# The API must NEVER set these to start consumers of its own. The two roles
# scale, restart and fail for different reasons (INV-190).

# pg-boss owns its own PostgreSQL schema, in the SAME database as the
# application. Same-instance is what makes transactional enqueue possible
# (ADR-011); moving the queue elsewhere breaks that silently.
QUEUE_SCHEMA=pgboss
# Let pg-boss create and upgrade its own tables. Set false when a deployment
# wants that under a controlled step instead.
QUEUE_MIGRATE=true
# The queue's own small pool, separate from the application pool. Total
# connections across API replicas plus both worker pools is a real constraint.
QUEUE_POOL_MAX=4

# Recurring sweeps. OFF by default, so starting a worker in a test or on a
# developer machine never registers a schedule against a shared database.
WORKER_SCHEDULES_ENABLED=false
# UTC. A server-local expression shifts with the deployment's timezone.
CLEANUP_CRON=0 * * * *
CLEANUP_BATCH_SIZE=500

# Optional override. Unset means each job's declared concurrency is used.
# WORKER_CONCURRENCY=
# Graceful drain bound. Unfinished jobs stay durable and are retried; the queue
# is the recovery mechanism, not a best-effort drain.
WORKER_SHUTDOWN_TIMEOUT_MS=30000

# ── Object storage (BACKEND-17) ──────────────────────────────────────────────
#
# S3-COMPATIBLE. No provider is hard-coded anywhere in the codebase - not AWS,
# not Linode, not MinIO. The deployment decides, which is the point of the
# adapter (ADR-012). Production provider and region are UNRESOLVED (OD-050) and
# carry the same data-residency review as the database.

# Absent means the provider's own regional endpoint (AWS). Set it for any other
# S3-compatible provider. MUST be https in production - a plaintext endpoint is
# refused, and the override below cannot be enabled in production.
#
# Local dev: docker-compose.local.yml runs a MinIO service for this — set
# OBJECT_STORAGE_ENDPOINT=http://localhost:9000, OBJECT_STORAGE_REGION=us-east-1
# (MinIO ignores the value; the SDK just requires a non-empty one), and see
# that compose file's minio service for the matching access key/secret.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=ap-southeast-1

# Two buckets, separated by TRUST rather than convenience, so a permission
# policy can distinguish untrusted uploads from accepted evidence.
# BOTH MUST BE PRIVATE. Public access must be blocked at the bucket level -
# the application cannot enforce that (BACKEND-58/65).
OBJECT_STORAGE_BUCKET_ARTIFACTS=lagda-artifacts
OBJECT_STORAGE_BUCKET_QUARANTINE=lagda-quarantine

# Least privilege: only the buckets, prefixes and actions the runtime needs.
# NOT account-level object-storage administration. Never committed; the loaded
# config is logged through an allowlist that excludes both of these.
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Path-style addressing (endpoint/bucket/key). Required by MinIO and by
# providers without per-bucket DNS. Set false for virtual-host style.
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Bounded, so a hung connection cannot wedge a worker.
OBJECT_STORAGE_REQUEST_TIMEOUT_MS=30000
# SDK transport retries. The worker separately retries whole jobs; two bounded
# layers is deliberate, a third would multiply.
OBJECT_STORAGE_MAX_ATTEMPTS=3

# LOCAL DEVELOPMENT ONLY. Allows a plaintext endpoint for a local
# S3-compatible service. REFUSED outright when NODE_ENV=production, so it
# cannot be left set in a deployment environment file.
# OBJECT_STORAGE_ALLOW_INSECURE=true

# Integration tests only: the endpoint of a local S3-compatible service.
# Storage integration tests skip cleanly when this is unset.
# OBJECT_STORAGE_TEST_ENDPOINT=http://127.0.0.1:9100

# ── Secure upload pipeline (BACKEND-18) ──────────────────────────────────────

# Maximum accepted document size. Handoff §7: "to be determined (suggest 25MB)".
# SUGGESTED, not decided (OD-056). Raising it affects request duration, memory
# (the file is buffered under this bound) and the scanner's own stream limit.
UPLOAD_MAX_BYTES=26214400
# A TECHNICAL safety maximum, not a commercial plan limit. A small file can
# declare a pathological page tree.
UPLOAD_MAX_PAGES=2000

# ── Malware scanning — MANDATORY ─────────────────────────────────────────────
#
# There is NO setting that disables scanning. If the scanner is unreachable,
# uploads fail closed: a file LAGDA could not scan is never accepted.
#
# Which scanner backs uploads. "clamav" (default) is self-hosted and the
# long-term intent — but its signature database needs ~1GB+ RAM resident,
# which some deployments (e.g. a budget-constrained VPS) cannot yet afford.
# "metadefender" is a temporary, hosted substitute for exactly that case —
# swap back to "clamav" once the deployment can host it; nothing else about
# the upload pipeline changes either way.
MALWARE_SCANNER_PROVIDER=clamav

# ── clamav mode ──────────────────────────────────────────────────────────────
# Local dev: docker-compose.local.yml runs a standard clamd (official
# clamav/clamav image) on port 3310 — set MALWARE_SCANNER_HOST=localhost.
# First boot is slow (downloads virus definitions) before it accepts scans.
MALWARE_SCANNER_HOST=
MALWARE_SCANNER_PORT=3310
# Bounds the whole scan, so a stuck scanner cannot hold an HTTP request open.
MALWARE_SCANNER_TIMEOUT_MS=30000
# Must be >= UPLOAD_MAX_BYTES and >= clamd's own StreamMaxLength, or large files
# arrive unscannable and are correctly refused — presenting as a LAGDA outage.
MALWARE_SCANNER_MAX_STREAM_BYTES=31457280

# ── metadefender mode ────────────────────────────────────────────────────────
# From MetaDefender Cloud's dashboard (API Key page). Never commit a real
# value. Confirm your plan's commercial-use terms before relying on this in
# production — see the free Community tier's Terms of Service.
MALWARE_SCANNER_METADEFENDER_API_KEY=
# MALWARE_SCANNER_METADEFENDER_API_BASE_URL=https://api.metadefender.com/v4
# MALWARE_SCANNER_METADEFENDER_POLL_INTERVAL_MS=2000
# MALWARE_SCANNER_METADEFENDER_MAX_POLL_ATTEMPTS=30

# Integration tests only: a local scanner. Upload integration tests skip
# cleanly when this is unset.
# MALWARE_SCANNER_TEST_HOST=127.0.0.1
# MALWARE_SCANNER_TEST_PORT=3310

# ── Authentication (BACKEND-19) ──────────────────────────────────────────────

# Which Terms of Service / Privacy Policy version a registering user accepts.
# Stored per account WITH a timestamp: a bare "accepted: true" is worthless the
# day the documents change.
TERMS_VERSION=2026-01-01

# How long a verification CODE stays valid. 24 hours (OD-065, resolved in
# BACKEND-21): long enough that someone registering in the evening can finish
# the next morning, short enough that a code sitting in a mailbox does not stay
# useful indefinitely. Expiry is derived from the stored timestamp - no job
# marks rows expired.
EMAIL_VERIFICATION_TTL_MS=86400000

# The canonical application URL verification links are built from. NEVER the
# incoming Host header - a Host-derived link sends the user's token to whatever
# domain an attacker put in the request (INV-244).
APP_BASE_URL=http://localhost:5173

# ── Transactional email (SMTP) ───────────────────────────────────────────────
#
# Read only by the WORKER process (packages/worker), never the API — the API
# never sends mail directly. Absent SMTP_PASSWORD means email delivery stays
# disabled and every notification queues as PENDING forever rather than the
# worker crashing at boot; the other three become required-for-presence only
# once a password is set (packages/email/src/config.ts).
#
# Current deployment target: GMass's SMTP relay. Nothing here is GMass-specific
# by name — swapping relays means changing these values, not the code.
SMTP_HOST=smtp.gmass.co
SMTP_PORT=587
# TLS is always required (STARTTLS on 587, or implicit TLS if you set this to
# 465) — there is no plaintext fallback. Leave unset to infer from the port;
# override only for a relay that doesn't follow the 587/465 convention.
# SMTP_SECURE=false
SMTP_USERNAME=gmass
# A FAKE placeholder. Never commit a real key. This is GMass's SMTP API key,
# not your GMass account password.
SMTP_PASSWORD=REPLACE_ME_WITH_YOUR_GMASS_SMTP_API_KEY

# The verified sending identity — must be a sender GMass has approved you to
# send as. What a recipient sees as "From" and where replies would go if
# nobody set EMAIL_REPLY_TO_ADDRESS.
EMAIL_FROM_ADDRESS=lagda.esignature.notification@gmail.com
EMAIL_FROM_DISPLAY_NAME=LAGDA
# EMAIL_REPLY_TO_ADDRESS=
# 1000-30000. How long the worker waits for the SMTP relay before treating the
# attempt as ambiguous rather than holding a delivery claim indefinitely.
# EMAIL_TIMEOUT_MS=10000

# Argon2id parameters. Explicit, never the library defaults. Floors are enforced
# in code: values below 19456 KiB / timeCost 2 are refused, so a deployment
# cannot quietly weaken password hashing.
# PASSWORD_ARGON2_MEMORY_KIB=19456
# PASSWORD_ARGON2_TIME_COST=2
# PASSWORD_ARGON2_PARALLELISM=1

# ── Multi-factor authentication (BACKEND-23) ─────────────────────────────────
#
# Encrypts TOTP secrets at rest. TOTP is the one credential the server must be
# able to RECOVER rather than merely compare, so a digest is not an option and
# plaintext is not acceptable.
#
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# UNSET means MFA enrolment is unavailable. It does NOT mean secrets are stored
# in the clear. Losing this key makes every enrolled factor undecryptable and
# every affected user dependent on their recovery codes.
#
# A FAKE placeholder. Never commit a real key.
MFA_SECRET_KEY=REPLACE_ME_WITH_32_RANDOM_BYTES_BASE64_ENCODED=
MFA_SECRET_KEY_VERSION=v1

# ── Account email verification provider (P2 Firebase migration) ─────────────
#
# Which provider delivers ACCOUNT EMAIL VERIFICATION messages, and ONLY that
# message type — password reset, signing invitations, and every other
# notification are unaffected by this setting regardless of its value.
#
# "default" (unset) — the pre-migration behavior, this deployment's normal
#   email delivery pipeline. No Firebase credential is required or read.
# "firebase" — Firebase Auth sends the verification email itself. Requires
#   FIREBASE_PROJECT_ID below, and either FIREBASE_SERVICE_ACCOUNT_JSON or an
#   environment that provides Application Default Credentials. Boot fails
#   loud if this is "firebase" and the credential is missing/malformed.
EMAIL_VERIFICATION_PROVIDER=default

# Required only when EMAIL_VERIFICATION_PROVIDER=firebase.
FIREBASE_PROJECT_ID=

# Optional even in firebase mode: leave unset to use Application Default
# Credentials (preferred in production, on a host that provides them). For
# local development, set this to the CONTENTS of a downloaded service-account
# JSON key (one line) — never commit the key file itself, and never commit a
# real value here.
FIREBASE_SERVICE_ACCOUNT_JSON=
