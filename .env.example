# LAGDA backend — example configuration.
#
# Foundation stage: no runtime configuration is required yet, because no process
# reads configuration. Nothing here is a secret and nothing here is real.
#
# Later commands add their own variables as the packages that consume them are
# built. Configuration will be parsed and VALIDATED ONCE at process startup and
# injected, rather than read from `process.env` throughout business code.
#
# Do not add production credentials, signing secrets, storage keys, email API
# keys, or cookie secrets to this file at any point.

NODE_ENV=development
