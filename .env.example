# LAGDA backend — example configuration.
#
# Foundation stage: no runtime configuration is required yet, because no process
# reads configuration. Nothing here is a secret and nothing here is real.
#
# Later commands add their own variables as the packages that consume them are
# built. Configuration will be parsed and VALIDATED ONCE at process startup and
# injected, rather than read from `process.env` throughout business code.
#
# Do not add production credentials, signing secrets, storage keys, email API
# keys, or cookie secrets to this file at any point.

NODE_ENV=development

# ── Database ────────────────────────────────────────────────────────────────
# Local PostgreSQL. These are FAKE placeholder values, not credentials.
# Create the databases once: CREATE DATABASE lagda_dev; CREATE DATABASE lagda_test;
DATABASE_URL=postgresql://user:password@localhost:5432/lagda_dev

# Integration tests only. The database name MUST contain "test" — the harness
# truncates tables and refuses to run against anything else.
DATABASE_TEST_URL=postgresql://user:password@localhost:5432/lagda_test

# Optional. Defaults: min 0, max 10, connect 10s, idle 30s, ssl off.
# DATABASE_POOL_MAX=10
# DATABASE_SSL=true

# ── API process (BACKEND-11) ────────────────────────────────────────────────
# Loopback by default. Production behind a reverse proxy typically needs 0.0.0.0.
API_HOST=127.0.0.1
API_PORT=8080

# Exact origins, comma separated. NEVER "*" — sessions are cookie-based, so a
# wildcard is either ignored by the browser or unsafe. Empty disables CORS
# entirely, which is correct when the frontend is same-origin.
CORS_ORIGINS=http://localhost:5173

# How much of the X-Forwarded-For chain to believe.
#   unset / false  → trust nothing (the default, and correct for local dev)
#   1              → exactly one reverse proxy in front
#   10.0.0.1,...   → specific trusted proxy addresses
# TRUST_PROXY=true is REJECTED: it trusts the whole chain, which would let any
# client choose the IP recorded as signing evidence.
# See docs/backend/api/TRUST_PROXY.md.
TRUST_PROXY=

LOG_LEVEL=info
# JSON bodies only. Uploads get their own limit on their own routes (BACKEND-18).
REQUEST_BODY_LIMIT=1048576
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=15000

# ── Worker (separate process: `npm run start:worker`) ────────────────────────
#
# The API must NEVER set these to start consumers of its own. The two roles
# scale, restart and fail for different reasons (INV-190).

# pg-boss owns its own PostgreSQL schema, in the SAME database as the
# application. Same-instance is what makes transactional enqueue possible
# (ADR-011); moving the queue elsewhere breaks that silently.
QUEUE_SCHEMA=pgboss
# Let pg-boss create and upgrade its own tables. Set false when a deployment
# wants that under a controlled step instead.
QUEUE_MIGRATE=true
# The queue's own small pool, separate from the application pool. Total
# connections across API replicas plus both worker pools is a real constraint.
QUEUE_POOL_MAX=4

# Recurring sweeps. OFF by default, so starting a worker in a test or on a
# developer machine never registers a schedule against a shared database.
WORKER_SCHEDULES_ENABLED=false
# UTC. A server-local expression shifts with the deployment's timezone.
CLEANUP_CRON=0 * * * *
CLEANUP_BATCH_SIZE=500

# Optional override. Unset means each job's declared concurrency is used.
# WORKER_CONCURRENCY=
# Graceful drain bound. Unfinished jobs stay durable and are retried; the queue
# is the recovery mechanism, not a best-effort drain.
WORKER_SHUTDOWN_TIMEOUT_MS=30000

# ── Object storage (BACKEND-17) ──────────────────────────────────────────────
#
# S3-COMPATIBLE. No provider is hard-coded anywhere in the codebase - not AWS,
# not Linode, not MinIO. The deployment decides, which is the point of the
# adapter (ADR-012). Production provider and region are UNRESOLVED (OD-050) and
# carry the same data-residency review as the database.

# Absent means the provider's own regional endpoint (AWS). Set it for any other
# S3-compatible provider. MUST be https in production - a plaintext endpoint is
# refused, and the override below cannot be enabled in production.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=ap-southeast-1

# Two buckets, separated by TRUST rather than convenience, so a permission
# policy can distinguish untrusted uploads from accepted evidence.
# BOTH MUST BE PRIVATE. Public access must be blocked at the bucket level -
# the application cannot enforce that (BACKEND-58/65).
OBJECT_STORAGE_BUCKET_ARTIFACTS=lagda-artifacts
OBJECT_STORAGE_BUCKET_QUARANTINE=lagda-quarantine

# Least privilege: only the buckets, prefixes and actions the runtime needs.
# NOT account-level object-storage administration. Never committed; the loaded
# config is logged through an allowlist that excludes both of these.
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Path-style addressing (endpoint/bucket/key). Required by MinIO and by
# providers without per-bucket DNS. Set false for virtual-host style.
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Bounded, so a hung connection cannot wedge a worker.
OBJECT_STORAGE_REQUEST_TIMEOUT_MS=30000
# SDK transport retries. The worker separately retries whole jobs; two bounded
# layers is deliberate, a third would multiply.
OBJECT_STORAGE_MAX_ATTEMPTS=3

# LOCAL DEVELOPMENT ONLY. Allows a plaintext endpoint for a local
# S3-compatible service. REFUSED outright when NODE_ENV=production, so it
# cannot be left set in a deployment environment file.
# OBJECT_STORAGE_ALLOW_INSECURE=true

# Integration tests only: the endpoint of a local S3-compatible service.
# Storage integration tests skip cleanly when this is unset.
# OBJECT_STORAGE_TEST_ENDPOINT=http://127.0.0.1:9100
