{
  "name": "@lagda/application",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ports": {
      "types": "./dist/common/ports/index.d.ts",
      "default": "./dist/common/ports/index.js"
    },
    "./errors": {
      "types": "./dist/common/errors/index.d.ts",
      "default": "./dist/common/errors/index.js"
    },
    "./workspaces": {
      "types": "./dist/workspaces/index.d.ts",
      "default": "./dist/workspaces/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean"
  },
  "dependencies": {
    "@lagda/contracts": "*",
    "@lagda/core": "*"
  },
  "sideEffects": false
}
